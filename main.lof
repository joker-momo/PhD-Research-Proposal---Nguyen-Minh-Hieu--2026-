\contentsline {figure}{\numberline {1}{\ignorespaces Graphical abstract of the proposed three-layer CEI architecture for UAV swarms.\relax }}{1}{figure.caption.2}%
\contentsline {figure}{\numberline {2}{\ignorespaces Illustrative latency--energy trade-off under different partitioning regimes. Each point corresponds to a specific partitioning--assignment configuration; clusters represent computation-dominant, communication-dominant, and balanced regimes. The Pareto front shows the set of non-dominated solutions.\relax }}{12}{figure.caption.8}%
\contentsline {figure}{\numberline {3}{\ignorespaces Collaborative edge inference with a simplified three-partition example under a bounded-$K$ model, illustrating how partition boundaries induce intermediate tensor transmissions between UAVs.\relax }}{14}{figure.caption.10}%
\contentsline {figure}{\numberline {4}{\ignorespaces Data flow and energy-aware communication protocol for CEI. The intermediate tensor ($T$) is compressed ($T_c$) before transmission to reduce bandwidth overhead and RF energy cost.\relax }}{15}{figure.caption.11}%
\contentsline {figure}{\numberline {5}{\ignorespaces Adaptive orchestration and fault tolerance by the intelligent control plane. When a UAV fails, the control plane reallocates missing partitions and reroutes tensors to maintain uninterrupted inference.\relax }}{16}{figure.caption.12}%
