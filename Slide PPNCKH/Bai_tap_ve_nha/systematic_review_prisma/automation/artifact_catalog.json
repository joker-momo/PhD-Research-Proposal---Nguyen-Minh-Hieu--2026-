{
  "schema_version": 1,
  "artifacts": [
    {
      "artifact_id": "hk261-automation-registry",
      "name": "HK261 automation evidence registry",
      "path": ".codex/hooks/automation_registry.py",
      "purpose": "Validate and search durable code-first decisions and reusable code artifacts.",
      "entrypoint": "python3 .codex/hooks/automation_registry.py validate|search <query>",
      "inputs": [
        "automation/artifact_catalog.json",
        "automation/decision_log.jsonl",
        "optional search query"
      ],
      "outputs": [
        "JSON validation counts",
        "JSON artifact and decision search results",
        "exit 2 with a specific validation error"
      ],
      "tests": [
        ".codex/hooks/test_automation_registry.py",
        ".codex/hooks/test_task_gate.py"
      ],
      "test_command": "PYTHONDONTWRITEBYTECODE=1 python3 .codex/hooks/test_automation_registry.py && PYTHONDONTWRITEBYTECODE=1 python3 .codex/hooks/test_task_gate.py",
      "status": "active",
      "tags": [
        "automation-first",
        "code-reuse",
        "evidence",
        "registry",
        "search",
        "validation"
      ]
    },
    {
      "artifact_id": "hk261-skill-router",
      "name": "HK261 advisory skill and code-mode router",
      "path": ".codex/hooks/skill_router.py",
      "purpose": "Recommend task ownership, focused skills and a code-first execution mode for every prompt.",
      "entrypoint": "python3 .codex/hooks/skill_router.py < hook-payload.json",
      "inputs": [
        "Codex hook JSON on stdin",
        "installed SKILL.md catalog"
      ],
      "outputs": [
        "owner and skill recommendation",
        "CODE_FIRST_DECISION recommendation",
        "registry lookup and evidence reminders"
      ],
      "tests": [
        ".codex/hooks/test_skill_router.py"
      ],
      "test_command": "PYTHONDONTWRITEBYTECODE=1 python3 .codex/hooks/test_skill_router.py",
      "status": "active",
      "tags": [
        "automation-first",
        "prompt-routing",
        "skills",
        "ownership"
      ]
    },
    {
      "artifact_id": "hk261-task-gate",
      "name": "HK261 task and A2A dispatch gate",
      "path": ".codex/hooks/task_gate.py",
      "purpose": "Block recognized A2A dispatch when owned scopes, status timestamps or automation evidence are invalid.",
      "entrypoint": "python3 .codex/hooks/task_gate.py < hook-payload.json",
      "inputs": [
        "Codex hook JSON on stdin",
        "Git owned-scope state",
        "current task state and event log",
        "automation registry"
      ],
      "outputs": [
        "exit 0 for allowed operations",
        "exit 2 and a specific blocking reason for invalid recognized dispatch"
      ],
      "tests": [
        ".codex/hooks/test_task_gate.py"
      ],
      "test_command": "PYTHONDONTWRITEBYTECODE=1 python3 .codex/hooks/test_task_gate.py",
      "status": "active",
      "tags": [
        "a2a",
        "automation-evidence",
        "git-gate",
        "timestamps"
      ]
    }
  ]
}
