<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 9.1-c001 79.675d0f7, 2023/06/11-19:21:16        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:pdfuaid="http://www.aiim.org/pdfua/ns/id/"
            xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
            xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#"
            xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#">
         <xmp:CreateDate>2026-03-12T17:17:25+05:30</xmp:CreateDate>
         <xmp:CreatorTool>Arbortext Advanced Print Publisher 9.0.223/W Unicode</xmp:CreatorTool>
         <xmp:ModifyDate>2026-03-13T08:27:11+05:30</xmp:ModifyDate>
         <xmp:MetadataDate>2026-03-13T08:27:11+05:30</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Knowledge Aggregation in Autonomous Systems via Pre-Trained Model</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>Muhammad Waqas Nawaz, Wanquan Zhang, Jaspreet Kaur, Qammer H. Abbasi, Muhammad Imran and Olaoluwa Popoola</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Transfer Learning â€“ Unlocking the Power of Pretrained Models&#xD;&#xA;DOI: http://dx.doi.org/10.5772/intechopen.1011880&#xD;&#xA;Abstract: Autonomous systems deployed across robotics, transportation, and aerial networks must operate under constraints of limited bandwidth, energy, and heterogeneous data. Centralized learning methods are often inadequate due to high latency, privacy concerns, and limited scalability. This chapter presents a unified framework for decentralized knowledge aggregation, leveraging pre-trained models (PTMs), feder-ated learning (FL), and edge intelligence to address these challenges. PTMs serve as portable knowledge units that reduce training overhead and enable fast, context-aware inference across distributed agents. The framework spans multiple domainsâ€”including the Internet of Robotic Things (IoRT), Connected Vehicular Networks (CVNs), Unmanned Aerial Vehicle (UAV) swarms, and Intelligent Transportation Systems (ITS)â€”and introduces task-aligned mechanisms such as one-shot inference, temporal clustering, multi-hop model fusion, and infrastructure-based calibration.&#xD;&#xA;These techniques aim to optimize model accuracy, energy efficiency, and responsive-ness across highly dynamic, resource-constrained environments. We evaluate our approach through both simulations and real-world testbeds, demonstrating improve-ments such as 15â€“20% gains in accuracy, 60% reductions in synchronization delay, and up to 70% savings in energy consumption over baseline models. The results validate PTM-assisted FL as a scalable and resilient strategy for real-time autonomous operations. However, we also discuss the practical challenges of PTM deployment, including device-level compute limitations and communication overhead. This work provides a modular blueprint for deploying collaborative, decentralized intelligence across edge-enabled ecosystems.&#xD;&#xA;</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>knowledge aggregation</rdf:li>
               <rdf:li>federated learning</rdf:li>
               <rdf:li>pre-trained models</rdf:li>
               <rdf:li>Internet of Robotic Things (IoRT)</rdf:li>
               <rdf:li>6G edge networks</rdf:li>
               <rdf:li>Unmanned Aerial Vehicles (UAVs)</rdf:li>
               <rdf:li>autonomous vehicles</rdf:li>
               <rdf:li>multi-task learning</rdf:li>
               <rdf:li>temporal clustering</rdf:li>
               <rdf:li>privacy-preserving AI</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <pdf:Producer>Acrobat DC</pdf:Producer>
         <pdf:Keywords>knowledge aggregation, federated learning, pre-trained models, Internet of Robotic Things (IoRT), 6G edge networks, Unmanned Aerial Vehicles (UAVs), autonomous vehicles, multi-task learning, temporal clustering, privacy-preserving AI&#xD;&#xA;</pdf:Keywords>
         <xmpMM:DocumentID>uuid:1e5ef3fc-be36-4add-911c-2408313be05c</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:ba867a81-ea1e-47ea-af50-b629c463701f</xmpMM:InstanceID>
         <pdfuaid:part>1</pdfuaid:part>
